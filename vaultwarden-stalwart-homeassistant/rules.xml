<!-- attacks-rules -->
<!-- Detections of attacks and attempts: Vaultwarden, Stalwart, Home Assistant, FIM (SSH keys, cron, web files, Vaultwarden
     configuration). Appended to /var/ossec/etc/rules/local_rules.xml by deploy.sh (the block is replaced on every run).
     Levels: >= 12 -> e-mail alert (with the default Wazuh e-mail threshold settings you configure); 10 -> dashboard only.
     Rollback: remove the block and restart the manager.
     Remember (see README, lessons): a parent rule must be defined before its child; among siblings, level-0 rules are checked
     first, then rules from the highest level down. -->

<!-- ===== Vaultwarden (container log, agent group `vaultwarden`) ===== -->
<group name="local,vaultwarden,authentication_failures,">
  <rule id="100150" level="0">
    <decoded_as>json</decoded_as>
    <match>[vaultwarden::</match>
    <description>Vaultwarden: log entries grouped</description>
  </rule>
  <rule id="100151" level="5">
    <if_sid>100150</if_sid>
    <match>Username or password is incorrect</match>
    <description>Vaultwarden: failed login of account $(dstuser) from $(srcip)</description>
    <group>authentication_failed,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100152" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100151</if_matched_sid>
    <same_source_ip />
    <description>Vaultwarden: >= 5 failed logins from $(srcip) in 10 min - possible brute force against the password vault</description>
    <group>authentication_failures,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100153" level="10">
    <if_sid>100150</if_sid>
    <match>Invalid admin token</match>
    <description>Vaultwarden: wrong /admin panel token from $(srcip) (the admin panel should not be reachable from untrusted networks)</description>
    <group>authentication_failed,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100154" level="8">
    <if_sid>100150</if_sid>
    <match>vaultwarden::ratelimit</match>
    <description>Vaultwarden: login rate limit exceeded (Too many login requests) - intensive login attempts</description>
    <group>authentication_failures,</group>
  </rule>
  <rule id="100155" level="8">
    <if_sid>100150</if_sid>
    <match type="pcre2">(?i)totp|two.?factor|recovery code|2fa</match>
    <description>Vaultwarden: failed second factor verification from $(srcip) - $(extra_data)</description>
    <group>authentication_failed,</group>
  </rule>
</group>

<!-- ===== Stalwart (/var/log/stalwart/stalwart.<date>, agent group `stalwart`) =====
     The INFO log level does not record failed authentications (auth.failed is a debug-level event), but it does record bans
     imposed by Stalwart's own mechanisms (scan, brute force, abuse) and blocked connections - the detection is based on those. -->
<group name="local,stalwart,">
  <rule id="100190" level="0">
    <decoded_as>stalwart</decoded_as>
    <description>Stalwart: log entries grouped</description>
  </rule>
  <rule id="100192" level="3">
    <if_sid>100190</if_sid>
    <match type="pcre2">\(security\.ip-blocked\)</match>
    <description>Stalwart: blocked connection from $(srcip) (address already banned)</description>
  </rule>
  <rule id="100191" level="5">
    <if_sid>100190</if_sid>
    <match type="pcre2">\(security\.(?:scan|loiter)-ban\)</match>
    <description>Stalwart: banned $(srcip) for scanning / loitering without commands (internet scanner)</description>
    <mitre><id>T1595</id></mitre>
  </rule>
  <rule id="100193" level="10">
    <if_sid>100190</if_sid>
    <match type="pcre2">\(security\.(?:authentication|brute-force|abuse)-ban\)</match>
    <description>Stalwart: banned $(srcip) for password guessing / mail abuse ($(id))</description>
    <group>authentication_failures,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100194" level="10" frequency="20" timeframe="3600">
    <if_matched_sid>100191</if_matched_sid>
    <description>Stalwart: >= 20 scan bans within an hour - coordinated scan of the mail server</description>
    <mitre><id>T1595</id></mitre>
  </rule>
</group>

<!-- ===== Home Assistant (one or more instances; ha-security-log collector, agent group `ha-security`) ===== -->
<group name="local,homeassistant,authentication_failures,">
  <rule id="100170" level="0">
    <decoded_as>ha-security</decoded_as>
    <description>Home Assistant: security entries grouped</description>
  </rule>
  <rule id="100171" level="5">
    <if_sid>100170</if_sid>
    <match>invalid authentication</match>
    <description>Home Assistant ($(label)): failed login or wrong token from $(srcip) - $(url)</description>
    <group>authentication_failed,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100172" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100171</if_matched_sid>
    <same_source_ip />
    <description>Home Assistant ($(label)): >= 5 failed logins from $(srcip) in 10 min - possible brute force</description>
    <group>authentication_failures,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100173" level="8">
    <if_sid>100170</if_sid>
    <match type="pcre2">(?i)banned ip|ip.*banned</match>
    <description>Home Assistant ($(label)): IP address banned after failed logins - $(extra_data)</description>
    <group>authentication_failures,</group>
  </rule>
  <rule id="100174" level="5">
    <if_sid>100170</if_sid>
    <match>untrusted proxy</match>
    <description>Home Assistant ($(label)): X-Forwarded-For header from an untrusted proxy - $(extra_data) (wrong trusted_proxies configuration or a bypass attempt)</description>
  </rule>
</group>

<!-- ===== FIM (syscheck): changes that indicate a compromise, not an attempt ===== -->
<group name="local,syscheck,fim_attacks,">
  <!-- root SSH keys (authorized_keys, id_*) - when you add your own key yourself, the alert is expected -->
  <rule id="100180" level="12">
    <if_sid>550, 553, 554</if_sid>
    <field name="file" type="pcre2">^/root/\.ssh/(?:authorized_keys|id_)</field>
    <description>FIM: root SSH keys changed - $(file)</description>
    <mitre><id>T1098.004</id></mitre>
  </rule>
  <rule id="100181" level="10">
    <if_sid>550, 553, 554</if_sid>
    <field name="file" type="pcre2">^/var/spool/cron/</field>
    <description>FIM: user cron jobs changed - $(file)</description>
    <mitre><id>T1053.003</id></mitre>
  </rule>
  <!-- A server without PHP: any .php/.phtml/.phar file in the web directories is a webshell -->
  <rule id="100182" level="12">
    <if_sid>550, 554</if_sid>
    <field name="file" type="pcre2">^/(?:srv|var/www)/.*(?:php\d?|phtml|phar)$</field>
    <description>FIM: PHP file in a web directory of a server without PHP (webshell?) - $(file)</description>
    <mitre><id>T1505.003</id></mitre>
  </rule>
  <!-- Zabbix frontend: new PHP file (changes to existing files during a package upgrade are normal - they stay at level 7) -->
  <rule id="100183" level="10">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">^/usr/share/zabbix/.*(?:php|phtml|phar)$</field>
    <description>FIM: new PHP file in the Zabbix frontend (webshell or package upgrade) - $(file)</description>
    <mitre><id>T1505.003</id></mitre>
  </rule>
  <!-- Vaultwarden configuration and key -->
  <rule id="100184" level="10">
    <if_sid>550, 553, 554</if_sid>
    <field name="file" type="pcre2">^/opt/vaultwarden/(?:data/(?:config\.json|rsa_key)|docker-compose\.yml)</field>
    <description>FIM: Vaultwarden configuration / key changed - $(file)</description>
  </rule>
</group>
<!-- /attacks-rules -->
