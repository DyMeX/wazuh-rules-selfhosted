#!/bin/sh
# Wazuh -> custom-ssh-home.py (wrapper as in the stock Wazuh integrations: Python from the manager's own framework)
WPYTHON_BIN="framework/python/bin/python3"
SCRIPT_PATH_NAME="$0"
DIR_NAME="$(cd "$(dirname "${SCRIPT_PATH_NAME}")"; pwd -P)"
SCRIPT_NAME="$(basename "${SCRIPT_PATH_NAME}")"
WAZUH_PATH="$(cd "${DIR_NAME}/.."; pwd)"
exec "${WAZUH_PATH}/${WPYTHON_BIN}" "${DIR_NAME}/${SCRIPT_NAME}.py" "$@"
