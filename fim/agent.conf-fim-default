  <!-- fim-default -->
  <!-- Realtime FIM for ALL agents (group "default"): root SSH keys and user cron files.
       Rules 100180 (level 12) and 100181 (level 10). The block between the markers is replaced by the fim-default switch of deploy.sh. -->
  <syscheck>
    <directories realtime="yes" check_all="yes" restrict="authorized_keys|id_">/root/.ssh</directories>
    <directories realtime="yes" check_all="yes">/var/spool/cron</directories>
  </syscheck>
  <!-- /fim-default -->
